*.sh text eol=lf

# 源码与文档统一 LF：索引与工作树一致，避免 Windows(core.autocrlf=true) 下
# 反复出现 "LF will be replaced by CRLF" 的噪声，以及多 agent 并行写入时
# 产生整文件 diff（内容相同却因行尾不同而全量变更）。
*.dart text eol=lf
*.md text eol=lf
*.py text eol=lf

# Preserve SDK provenance hashes.
apps/mobile_flutter/third_party/matrix/** -text
# Keep the published embedded statistics resource byte-identical on macOS/Windows.
apps/mobile_flutter/assets/html/statistics_tools_combined_v2.html -text whitespace=cr-at-eol
docs/verification/artifacts/2026-08-26/e2ee-session-capability-boundary/DIFF_FILE.patch -whitespace

# Unified diff context lines intentionally retain their leading space.
third_party/synapse/patches/*.patch -whitespace

# Preserve published recovery and wallet T2 bytes across Windows/Linux checkouts.
# These exact paths contain mixed line endings or otherwise need release SHA stability.
packages/api-contracts/openapi/liuhetong-v1.yaml text eol=lf
services/business-api/requirements.lock text eol=lf
services/business-api/app/api/client_diagnostics.py -text whitespace=cr-at-eol
services/business-api/app/core/config.py -text whitespace=cr-at-eol
services/business-api/app/integrations/private_storage.py -text whitespace=cr-at-eol
services/business-api/app/modules/identity/profile.py -text whitespace=cr-at-eol
services/business-api/app/modules/moments/models.py -text whitespace=cr-at-eol
services/business-api/app/modules/moments/service.py -text whitespace=cr-at-eol
services/business-api/pyproject.toml -text whitespace=cr-at-eol
services/business-worker/app/integrations/avatar_reader.py -text whitespace=cr-at-eol
tests/business_api/moments/test_moment_video_posters.py -text whitespace=cr-at-eol
tests/business_api/test_migrations.py -text whitespace=cr-at-eol
