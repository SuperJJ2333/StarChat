COMPOSE_PROJECT_NAME=starchat

POSTGRES_IMAGE=postgres:16.9-alpine
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.132.0
# Matrix 推送网关（Sygnal）：显式版本，latest 禁止。
SYGNAL_IMAGE=matrixdotorg/sygnal:v0.15.1
ELEMENT_WEB_IMAGE=vectorim/element-web:v1.11.100
PYTHON_IMAGE=python:3.12.11-slim
REDIS_IMAGE=redis:7.4.2-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.27.8
COTURN_IMAGE=coturn/coturn:4.6.3-r3
# TURN TLS 兜底 URI（生产：turns:<域名>:5349?transport=tcp；留空则渲染
# 占位值。需 coturn TLS 与防火墙/安全组放行 5349，见 docs/TURN.md）。
TURN_URI_TLS=turns:matrix.localhost:5349?transport=tcp
NGINX_IMAGE=nginx:1.27.5-alpine

POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_INITDB_ARGS=--locale=C --encoding=UTF8
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MATRIX_SERVER_NAME=matrix.localhost
PUBLIC_HOSTNAME=example.com
WWW_PUBLIC_HOSTNAME=www.example.com
ADMIN_PUBLIC_HOSTNAME=admin.example.com
SYNAPSE_PUBLIC_BASEURL=https://example.com/
SYNAPSE_INTERNAL_BASEURL=http://synapse:8008/
ELEMENT_PUBLIC_URL=https://example.com/

SYNAPSE_HTTP_PORT=8008
ELEMENT_HTTP_PORT=8080
MATRIX_BOT_HTTP_PORT=8081
TURN_PORT=3478
TURN_EXTERNAL_IP=10.0.2.2
TURN_URI_UDP=turn:10.0.2.2:3478?transport=udp
TURN_URI_TCP=turn:10.0.2.2:3478?transport=tcp
TURN_SHARED_SECRET=change-this-turn-shared-secret

SYNAPSE_ADMIN_USERNAME=admin
SYNAPSE_ADMIN_PASSWORD=change-this-admin-password
SYNAPSE_BOT_USERNAME=matrixbot
SYNAPSE_BOT_PASSWORD=change-this-bot-password
MATRIX_BOT_USER_ID=@matrixbot:matrix.localhost
MATRIX_BOT_DEVICE_ID=STARCHATBOT
MATRIX_BOT_ACCESS_TOKEN=
SYNAPSE_ADMIN_ACCESS_TOKEN=
MATRIX_PROVISION_SECRET=change-this-matrix-provision-secret

SYNAPSE_REGISTRATION_SHARED_SECRET=change-this-registration-shared-secret
SYNAPSE_MACAROON_SECRET_KEY=change-this-macaroon-secret
SYNAPSE_FORM_SECRET=change-this-form-secret

MATRIX_WEBHOOK_API_KEY=change-this-internal-api-key
MATRIX_DEFAULT_ROOM_ID=
MATRIX_ROOM_ROUTING_JSON={"default":"!replace-with-room-id:matrix.localhost","announcement":"!replace-with-room-id:matrix.localhost","event:lottery_draw":"#lottery:matrix.localhost"}
MATRIX_ALLOWED_ROOM_TARGETS_JSON=["!replace-with-room-id:matrix.localhost","#lottery:matrix.localhost"]
MATRIX_AUTO_REPLY_RULES_JSON=[{"contains":"客服","reply":"客服已收到，请稍候。"},{"contains":"开奖","reply":"开奖提醒已记录，系统会自动推送最新结果。"}]
MATRIX_ADMIN_USERS_JSON=["@admin:matrix.localhost"]
MATRIX_COMMAND_PREFIX=!

BOT_APP_NAME=六合通 Matrix Bot
BOT_LOG_LEVEL=INFO
MATRIX_SYNC_TIMEOUT_MS=30000
MATRIX_SYNC_FULL_STATE=true
MATRIX_MESSAGE_DEDUP_TTL_SECONDS=3600
MATRIX_IDEMPOTENCY_DB_PATH=/data/bot/idempotency.sqlite3
MATRIX_ALLOW_UNVERIFIED_DEVICES=true
MATRIX_BOT_STORE_PATH=/data/bot/store

BUSINESS_APP_NAME=六合通 Business API
BUSINESS_ENVIRONMENT=development
BUSINESS_POSTGRES_DB=liuhetong
BUSINESS_POSTGRES_USER=liuhetong
BUSINESS_POSTGRES_PASSWORD=change-this-business-postgres-password
BUSINESS_DATABASE_URL=postgresql+psycopg://liuhetong:change-this-business-postgres-password@business-postgres:5432/liuhetong
BUSINESS_REDIS_URL=redis://business-redis:6379/0
BUSINESS_JWT_ISSUER=liuhetong
BUSINESS_JWT_SECRET=change-this-business-jwt-secret-at-least-32-bytes
BUSINESS_TOTP_ISSUER=六合通
BUSINESS_EMAIL_VERIFICATION_SECRET=change-this-email-verification-secret
BUSINESS_PASSWORD_RESET_SECRET=change-this-password-reset-secret
BUSINESS_MATRIX_HOMESERVER_URL=http://synapse:8008/
BUSINESS_MATRIX_PUBLIC_HOMESERVER_URL=https://example.com/
BUSINESS_MATRIX_SERVER_NAME=matrix.localhost
BUSINESS_MATRIX_LOGIN_TOKEN_EXPIRES_IN=60
BUSINESS_AVATAR_STORAGE_ROOT=/data/private-media
BUSINESS_AVATAR_URL_SIGNING_SECRET=change-this-avatar-url-signing-secret
BUSINESS_AVATAR_PUBLIC_BASE_URL=https://example.com
BUSINESS_API_HTTP_PORT=8082
BUSINESS_WORKER_ID=business-worker-1
BUSINESS_RED_PACKET_MAX_TOTAL=20000.00
# Referral 邀请码（30 分钟轮换）：生产必须更换为强随机值
BUSINESS_REFERRAL_CODE_SECRET=change-this-referral-code-secret
BUSINESS_REFERRAL_ROTATION_SECONDS=1800
BUSINESS_REFERRAL_SHARE_BASE_URL=https://example.com/register
BUSINESS_REFERRAL_REWARD_ENABLED=false
# 业务域图片压缩接口的输入上限（字节）
BUSINESS_MEDIA_MAX_UPLOAD_BYTES=10485760

MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
SMTP_HOST=mailpit
SMTP_DELIVERY_ENABLED=true
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=畅聊 <noreply@localhost>
SMTP_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_PUBLIC_BASE_URL=https://example.com


BUSINESS_WALLET_WEBHOOK_SECRET=change-this-wallet-webhook-secret

# 个推桥接（getui-bridge）：AppID 为公开标识；AppKey/签名密钥为服务端
# 机密，只写本文件对应的服务器 .env（绝不提交真实值）。
# GETUI_SIGN_SECRET：官方经典控制台为 MasterSecret，新版控制台为
# AppSecret——签名算法相同（sha256(appkey+timestamp+secret)）。
GETUI_APP_ID=
GETUI_APP_KEY=
GETUI_SIGN_SECRET=
GETUI_MATRIX_APP_ID=com.liuhetong.mobile.getui
