.env
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
data/
migration-artifacts/
.superpowers/
.worktrees/
.github/
.claude/
.agents/
.venv/
*.egg-info/
/build/
*.lnk
coverage.xml
htmlcov/
docs/verification/**/*.tmp
frontend/downloads/
.codegraph/
# FCM 凭据（含项目 API 元数据，绝不入库；docs/PUSH_SETUP.md）
apps/mobile_flutter/android/app/google-services.json
# APNs 凭据
*.p8
!docs/**/*.p8.md
# 验证产物中的 APK 二进制不入库（文本证据保留；63MB 二进制走网盘/工件库）
docs/verification/artifacts/**/*.apk
# 第三方审计工作副本（完整源码快照，不入库；其结论文档另行提交）
docs/verification/nomin36/
# 无混淆构建源码快照与 APK（同 nomin36：结论文档保留，二进制/快照不入库）
docs/verification/plain36/src/
docs/verification/plain36/*.apk
docs/verification/plain36/source.zip
# APK 反编译工作目录（路径超长无法索引；结论文档保留）
docs/verification/artifacts/**/decoded/
docs/verification/artifacts/**/apk-rebuild-test/
docs/verification/artifacts/**/rebuild-*/
docs/verification/artifacts/**/verified-decoded/
# 2026-09-05 审计/验证工件目录整体不入库（大量源码快照/二进制/浏览器 profile）
docs/verification/artifacts/2026-09-05/group-qr-video/
docs/verification/artifacts/2026-09-05/call-permissions-return/
docs/verification/artifacts/2026-09-05/call-connection/
docs/verification/artifacts/2026-09-05/background-call-signature/
docs/verification/artifacts/2026-09-05/friendship-deploy/
docs/verification/artifacts/2026-09-05/incoming-call-permission-dedup/
docs/verification/artifacts/2026-09-05/privacy-forward/
# Keep local third-party scratch packages ignored, but ship the patched Matrix
# path dependency required by clean CI checkouts.
apps/mobile_flutter/third_party/*
!apps/mobile_flutter/third_party/matrix/
apps/mobile_flutter/third_party/matrix/*
!apps/mobile_flutter/third_party/matrix/lib/
!apps/mobile_flutter/third_party/matrix/pubspec.yaml
!apps/mobile_flutter/third_party/matrix/analysis_options.yaml
!apps/mobile_flutter/third_party/matrix/LICENSE
!apps/mobile_flutter/third_party/matrix/README.md
!apps/mobile_flutter/third_party/matrix/CHANGELOG.md
!apps/mobile_flutter/third_party/matrix/CHATFLOW_PATCH.md
!apps/mobile_flutter/third_party/matrix/UPSTREAM_SHA256.json
# 其余大体量验证工件（APK/日志快照；结论在各验证 md 文档中）
docs/verification/artifacts/2026-09-05/call-echo-scan/
docs/verification/artifacts/2026-09-05/call-dismiss-release/
docs/verification/artifacts/2026-09-05/mi6-upgrade/
docs/verification/artifacts/2026-09-05/modifier-apk-comparison/
docs/verification/artifacts/2026-09-05/gallery-save/
docs/verification/artifacts/**/*.apk
