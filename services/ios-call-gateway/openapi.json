{
  "openapi": "3.1.0",
  "info": {
    "title": "iOS call wake gateway",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/devices/ios": {
      "put": {
        "summary": "Register",
        "operationId": "register_v1_devices_ios_put",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Device"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Unregister",
        "operationId": "unregister_v1_devices_ios_delete",
        "parameters": [
          {
            "name": "X-Registration-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "X-Registration-Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "204": {
            "description": "No matching active route; registration owner retired"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/calls": {
      "post": {
        "summary": "Create",
        "operationId": "create_v1_calls_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Call"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/calls/end": {
      "post": {
        "summary": "End",
        "operationId": "end_v1_calls_end_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reference"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/calls/answer": {
      "post": {
        "summary": "Answer",
        "operationId": "answer_v1_calls_answer_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reference"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/calls/status": {
      "get": {
        "summary": "Status",
        "operationId": "status_v1_calls_status_get",
        "parameters": [
          {
            "name": "room_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 255,
              "pattern": "^![^\\s/]+:[^\\s/]+$",
              "title": "Room Id"
            }
          },
          {
            "name": "call_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9._~+\\-/=]+$",
              "title": "Call Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Call": {
        "properties": {
          "room_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^![^\\s/]+:[^\\s/]+$",
            "title": "Room Id"
          },
          "call_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._~+\\-/=]+$",
            "title": "Call Id"
          },
          "recipient": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^@[^\\s/]+:[^\\s/]+$",
            "title": "Recipient"
          },
          "video": {
            "type": "boolean",
            "title": "Video"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "room_id",
          "call_id",
          "recipient",
          "video"
        ],
        "title": "Call"
      },
      "Device": {
        "properties": {
          "registration_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "Registration Id"
          },
          "voip_token": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64,200}$",
            "title": "Voip Token"
          },
          "apns_token": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64,200}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Apns Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "registration_id",
          "voip_token"
        ],
        "title": "Device"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Reference": {
        "properties": {
          "room_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^![^\\s/]+:[^\\s/]+$",
            "title": "Room Id"
          },
          "call_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._~+\\-/=]+$",
            "title": "Call Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "room_id",
          "call_id"
        ],
        "title": "Reference"
      },
      "Result": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "state"
        ],
        "title": "Result"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
