{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOnlyInstallerBucketInSingapore",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::starchat-installers-218022113852-sg",
      "Condition": {
        "StringEquals": {
          "s3:LocationConstraint": "ap-southeast-1"
        }
      }
    },
    {
      "Sid": "ConfigureOnlyInstallerBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::starchat-installers-218022113852-sg"
    },
    {
      "Sid": "ListOnlyInstallerDownloads",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::starchat-installers-218022113852-sg",
      "Condition": {
        "StringLike": {
          "s3:prefix": "downloads/*"
        }
      }
    },
    {
      "Sid": "ReadWriteOnlyInstallerDownloads",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::starchat-installers-218022113852-sg/downloads/*"
    },
    {
      "Sid": "ReadCloudFrontInventory",
      "Effect": "Allow",
      "Action": [
        "cloudfront:ListDistributions",
        "cloudfront:ListOriginAccessControls"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BootstrapCreateOriginAccessControl",
      "Effect": "Allow",
      "Action": "cloudfront:CreateOriginAccessControl",
      "Resource": "*"
    },
    {
      "Sid": "ReadAccountOriginAccessControls",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetOriginAccessControl",
        "cloudfront:GetOriginAccessControlConfig"
      ],
      "Resource": "arn:aws:cloudfront::218022113852:origin-access-control/*"
    },
    {
      "Sid": "MaintainOnlyTaggedInstallerDistributions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:ListTagsForResource",
        "cloudfront:UpdateDistribution"
      ],
      "Resource": "arn:aws:cloudfront::218022113852:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "StarChatInstallerDelivery"
        }
      }
    }
  ]
}
