PUBLIC_HOSTNAME=liuhetong888.com
WWW_PUBLIC_HOSTNAME=www.liuhetong888.com
ADMIN_PUBLIC_HOSTNAME=admin.liuhetong888.com
SYNAPSE_PUBLIC_BASEURL=https://liuhetong888.com

# These paths are mounted into the gateway container or host Nginx.
NGINX_TLS_FULLCHAIN_PATH=/etc/nginx/certs/fullchain.pem
NGINX_TLS_PRIVATE_KEY_PATH=/etc/nginx/certs/privkey.pem

# Internal-only upstreams. Do not replace these with public URLs.
BUSINESS_API_UPSTREAM=business-api:8082
SYNAPSE_UPSTREAM=synapse:8008
ELEMENT_UPSTREAM=element-web:80
