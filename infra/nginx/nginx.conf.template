limit_req_zone $binary_remote_addr zone=ios_calls_rate:1m rate=5r/s;
upstream ios_call_gateway_upstream {
    zone ios_call_gateway_upstream 64k;
    server ios-call-gateway:8000 resolve;
}

resolver 127.0.0.11 valid=10s ipv6=off;

upstream business_api_upstream {
    zone business_api_upstream 64k;
    server business-api:8082 resolve;
}

upstream synapse_sync_upstream {
    zone synapse_sync_upstream 64k;
    server synapse-sync-worker:8081 resolve;
}

upstream synapse_upstream {
    zone synapse_upstream 64k;
    server synapse:8008 resolve;
}

upstream element_upstream {
    zone element_upstream 64k;
    server element-web:80 resolve;
}

upstream getui_bridge_upstream {
    zone getui_bridge_upstream 64k;
    server getui-bridge:8088 resolve;
}

upstream sygnal_upstream {
    zone sygnal_upstream 64k;
    server sygnal:5000 resolve;
}

# Synapse requires the exact /_matrix/push/v1/notify path.
# Only fixed configured upstreams are selectable, never a user-provided host.
map $arg_provider $matrix_push_upstream {
    default sygnal_upstream;
    getui getui_bridge_upstream;
}

server {
    listen 80;
    server_name {{PUBLIC_HOSTNAME}} {{ADMIN_PUBLIC_HOSTNAME}};
    return 301 https://$host$request_uri;
}

server {
    listen 80;
    server_name {{WWW_PUBLIC_HOSTNAME}};
    return 301 https://{{WWW_PUBLIC_HOSTNAME}}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{PUBLIC_HOSTNAME}};

    # chatflow-enterprise-download-v1
    location = / { return 302 https://{{WWW_PUBLIC_HOSTNAME}}/download; }
    location = /download { return 302 https://{{WWW_PUBLIC_HOSTNAME}}/download; }
    location = /download/ { return 302 https://{{WWW_PUBLIC_HOSTNAME}}/download; }


    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location ^~ /_synapse/admin/ {
        return 404;
    }

    location = /.well-known/matrix/client {
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "public, max-age=3600" always;
        return 200 '{"m.homeserver":{"base_url":"{{SYNAPSE_PUBLIC_BASEURL}}"}}';
    }

    location /ios-call/ {
        limit_req zone=ios_calls_rate burst=20 nodelay;
        limit_req_status 429;
        client_max_body_size 4k;
        client_body_timeout 10s;
        access_log off;
        proxy_pass http://ios_call_gateway_upstream/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
    }

    location /api/v1/ {
        client_max_body_size 25m;
        proxy_pass http://business_api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
    }

    # 个推桥接网关：自建 Matrix Push Gateway（业务内容在 bridge 内丢弃，
    # 只按 CID 下发通用文案；密钥仅服务器 .env）。
    location /_matrix/push/v1/getui/ {
        proxy_pass http://getui_bridge_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    # Sygnal（FCM/APNs 预留通道，休眠态）。更长前缀优先于 /_matrix/。
    location /_matrix/push/v1/notify {
        proxy_pass http://$matrix_push_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location ~ ^/_matrix/client/(r0|v3)/(sync|events)$ {
        proxy_pass http://synapse_sync_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    location ~ ^/_matrix/client/(api/v1|r0|v3|unstable)/login/?$ {
        client_max_body_size 16k;
        rewrite ^ /api/v1/auth/matrix-broker break;
        proxy_pass http://business_api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
    # CHAT-RELIABILITY-2084: private token issuers cannot be public.
    location ~ ^/_matrix/client/[^/]+/(login|register|refresh|sso|cas|saml2|oidc)(/|$) { return 403; }
    location ~ ^/_matrix/client/api/v1/(login|register|refresh|sso|cas|saml2|oidc)(/|$) { return 403; }
    location ^~ /_synapse/client/ { return 403; }

    location /_matrix/ {
        client_max_body_size 100m;
        proxy_pass http://synapse_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    location / {
        proxy_pass http://element_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{WWW_PUBLIC_HOSTNAME}};

    # chatflow-enterprise-download-www-v1
    location = /download {
        try_files /download.html =404;
        add_header Cache-Control "no-store" always;
    }
    location = /download/ { return 302 /download; }
    location = /downloads/ios/manifest.plist {
        types { }
        default_type application/xml;
        try_files $uri =404;
        add_header Cache-Control "no-store" always;
    }
    location ^~ /downloads/ios/ {
        types { }
        default_type application/octet-stream;
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=3600" always;
    }


    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html/admin;
    index home.html;
    location / {
        try_files $uri $uri/ /home.html;
        add_header Cache-Control "no-store" always;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ADMIN_PUBLIC_HOSTNAME}};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location ^~ /_synapse/admin/ {
        return 404;
    }

    location /api/v1/ {
        client_max_body_size 25m;
        proxy_pass http://business_api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
    }

    location / {
        root /usr/share/nginx/html/admin;
        index admin.html;
        try_files $uri $uri/ /admin.html;
        add_header Cache-Control "no-store" always;
    }
}
