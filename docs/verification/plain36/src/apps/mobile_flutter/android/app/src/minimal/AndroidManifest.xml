<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 安全审计诊断构建（docs/ANDROID_SECURITY_AUDIT.md）：
         与 standard/release 相比裁剪"非聊天必需 + 高危启发式"权限，
         并关闭主界面的锁屏全屏拉起行为。用于与误报做二分定位，
         不用于生产发布。 -->

    <!-- 杀软灰名单高频特征：锁屏全屏弹出来电界面 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:node="remove" />
    <!-- 精确闹钟（消息提醒）：诊断构建改由非精确路径，验证其是否参与误报 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
    <!-- 前台服务类型化权限（通话保活）：聊天基础功能不需要 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"
        tools:node="remove" />
    <!-- 库注入（photo_manager）：Android 9- 保存图片才需要，诊断构建裁剪 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <!-- 库注入（flutter_webrtc，≤Android 10 蓝牙话筒路由）：诊断构建裁剪 -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        tools:node="remove" />

    <!-- 关闭主界面锁屏显示/点亮屏幕（来电全屏行为的载体） -->
    <application>
        <activity
            android:name=".MainActivity"
            android:showWhenLocked="false"
            android:turnScreenOn="false"
            tools:replace="android:showWhenLocked,android:turnScreenOn" />
    </application>
</manifest>
